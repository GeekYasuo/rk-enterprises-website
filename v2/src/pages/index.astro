---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { products, stages, productsIn, company, waLink, tel, sheetNo } from '../data/products'

const heroMachine = products.find((p) => p.slug === 'wfi-storage-tank')!
const bySlug = (slug: string) => products.find((p) => p.slug === slug)!

const industries = [
  { name: 'Pharmaceutical', use: 'Granulation, drying, coating and oral-liquid lines' },
  { name: 'Food & beverage', use: 'Syrups, oils, powders and blends' },
  { name: 'Chemical', use: 'Liquid filtration, drying and powder mixing' },
  { name: 'Cosmetics', use: 'Emulsions, creams and liquid clarification' },
  { name: 'Specialty processing', use: 'Handling, storage and custom process needs' },
]

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: company.name,
  description: 'Manufacturer of pharmaceutical and industrial process equipment in Vasai-Virar, Maharashtra.',
  telephone: company.phones,
  email: company.email,
  url: 'https://rk-enterprises.co/',
  address: { '@type': 'PostalAddress', streetAddress: company.address.slice(0, 2).join(', '), addressLocality: 'Vasai-Virar', addressRegion: 'Maharashtra', postalCode: '421302', addressCountry: 'IN' },
  openingHours: 'Mo-Sa 09:00-18:00',
}
---
<Base description="RK Enterprises manufactures sparkler filter presses, dryers, blenders, mills and granulation equipment for pharmaceutical, food, chemical and cosmetics production in Vasai-Virar, Maharashtra." schema={schema}>

  <section class="hero grid-paper">
    <div class="wrap hero-grid">
      <div class="copy">
        <p class="note">Process equipment manufacturer · Vasai-Virar, Maharashtra</p>
        <h1 class="display h1">Process equipment, built to <span class="accent">your spec.</span></h1>
        <p class="lead">Filtration, milling, coating, drying, blending and granulation equipment for pharmaceutical, food, chemical and cosmetics production.</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/equipment/">Browse all {products.length} machines <Icon name="arrow" size={16} /></a>
          <a class="btn btn-wa" href={waLink("Hi RK Enterprises, I'd like to enquire about your process equipment.")} target="_blank" rel="noopener"><Icon name="chat" size={18} /> WhatsApp us</a>
        </div>
        <dl class="title-block facts" style="--cols:3">
          <div><dt class="note">Machine types</dt><dd class="num">{products.length}</dd></div>
          <div><dt class="note">Projects delivered</dt><dd class="num">100+</dd></div>
          <div><dt class="note">Project support</dt><dd class="num">24/7</dd></div>
        </dl>
      </div>

      <figure class="drawing">
        <div class="plate sheet">
          <a class="photo" href={`/equipment/${heroMachine.slug}/`} aria-label={`${heroMachine.name} details`}><img src={`/machines/${heroMachine.image}`} alt={`${heroMachine.name}s by RK Enterprises`} width="375" height="285" fetchpriority="high" /></a>
          <svg class="dims" viewBox="0 0 500 400" aria-hidden="true">
            <g class="dim d1"><path d="M40 356H420M40 346v20M420 346v20" /><text x="230" y="384">W · TO YOUR SPEC</text></g>
            <g class="dim d2"><path d="M448 40V329M438 40h20M438 329h20" /><text x="0" y="0" transform="translate(474 184) rotate(90)">H · TO YOUR SPEC</text></g>
            <g class="dim d3"><path d="M276 76 246 26H150" /><circle cx="276" cy="76" r="3.5" /><text x="150" y="19" class="left">SS CONSTRUCTION</text></g>
          </svg>
        </div>
        <figcaption>
          <dl class="title-block" style="--cols:4">
            <div><dt class="note">Drawing</dt><dd>{heroMachine.name}</dd></div>
            <div><dt class="note">Sheet</dt><dd class="num">{sheetNo(heroMachine)} / {products.length}</dd></div>
            <div><dt class="note">Scale</dt><dd>Not to scale</dd></div>
            <div><dt class="note">Built</dt><dd>To order</dd></div>
          </dl>
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="process" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display h2">Find equipment by process step</h2>
        <p class="lead">Start from what your line needs to do. Each step lists the machines we build for it.</p>
      </div>
      <div class="stages">
        {stages.map((s) => {
          const list = productsIn(s.id)
          const cover = bySlug(s.cover)
          return (
            <article class="stage">
              <a class="stage-img" href={`/equipment/#${s.id}`} tabindex="-1" aria-hidden="true"><img src={`/machines/${cover.image}`} alt="" loading="lazy" /></a>
              <div class="stage-body">
                <div class="stage-head">
                  <h3 class="h3"><a href={`/equipment/#${s.id}`}>{s.name}</a></h3>
                  <span class="count note"><span class="num">{list.length}</span> {list.length === 1 ? 'machine' : 'machines'}</span>
                </div>
                <p class="muted">{s.blurb}</p>
                <ul class="machine-links">
                  {list.map((p) => <li><a href={`/equipment/${p.slug}/`}><span>{p.name}</span><Icon name="arrow" size={15} /></a></li>)}
                </ul>
              </div>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="wrap about-grid">
      <div>
        <h2 class="display h2">From drawing board to delivery.</h2>
        <p class="lead" style="margin-top:24px">RK Enterprises pairs practical manufacturing experience with an exacting approach to detail. We make equipment that earns its place on your floor, shift after shift.</p>
      </div>
      <ol class="process">
        <li><h3 class="h3">Understand the process</h3><p class="muted">Every project starts with the details of your operation.</p></li>
        <li><h3 class="h3">Engineer the answer</h3><p class="muted">We match material, geometry and controls to the task.</p></li>
        <li><h3 class="h3">Build with accountability</h3><p class="muted">Made, tested and delivered by people who stand behind it.</p></li>
      </ol>
    </div>
  </section>

  <section id="industries" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display h2">Industries we build for</h2>
        <p class="lead">The same fabrication discipline, applied to very different products.</p>
      </div>
      <ul class="industries">
        {industries.map((i) => <li><h3 class="h3">{i.name}</h3><p class="muted">{i.use}</p></li>)}
      </ul>
    </div>
  </section>

  <section id="contact" class="section visit grid-paper">
    <div class="wrap visit-grid">
      <div>
        <h2 class="display h2">Talk to us about your line.</h2>
        <p class="lead" style="margin-top:20px">Tell us the product, batch size and timeline. We'll recommend equipment and send a quote.</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/contact/">Request a quote <Icon name="arrow" size={16} /></a>
          <a class="btn btn-wa" href={waLink("Hi RK Enterprises, I'd like to discuss equipment for my production line.")} target="_blank" rel="noopener"><Icon name="chat" size={18} /> WhatsApp</a>
        </div>
      </div>
      <div class="visit-side">
      <a class="map-card" href={company.mapUrl} target="_blank" rel="noopener" aria-label="Open RK Enterprises location in Google Maps">
        <iframe title="RK Enterprises location map" loading="lazy" tabindex="-1" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=A1+Industrial+Estate+Kaman+Vasai-Virar+Maharashtra+421302&output=embed"></iframe>
        <span class="map-cta"><Icon name="up-right" size={14} /> Open in Google Maps</span>
      </a>
      <dl class="title-block office" style="--cols:2">
        <div class="span"><dt class="note">Head office</dt><dd>{company.address.join(', ')}</dd></div>
        <div><dt class="note">Phone</dt><dd>{company.phones.map((p) => <a class="num" href={tel(p)}>{p}</a>)}</dd></div>
        <div><dt class="note">Hours</dt><dd>{company.hours}</dd></div>
        <div><dt class="note">GST</dt><dd class="num">{company.gst}</dd></div>
        <div><dt class="note">Directions</dt><dd><a class="link" href={company.mapUrl} target="_blank" rel="noopener">Open in Google Maps <Icon name="up-right" size={14} /></a></dd></div>
      </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--line) }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: clamp(32px, 5vw, 80px); align-items: center; padding-block: clamp(40px, 7vw, 96px) clamp(48px, 7vw, 104px) }
  .copy { display: grid; gap: 22px; justify-items: start }
  .accent { color: var(--accent) }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px }
  .facts { width: 100%; max-width: 480px; margin-top: 10px }
  .facts dd { font-size: 22px; font-weight: 500 }
  @media (max-width: 640px) { .facts.title-block { grid-template-columns: repeat(3, minmax(0, 1fr)) } .facts.title-block > div { border-top: 0 } .facts.title-block > div + div { border-left: 1px solid var(--line) } .facts dd { font-size: 19px } }

  .drawing { margin: 0; display: grid; gap: 0 }
  .sheet { aspect-ratio: 5 / 4; border-bottom: 0 }
  .photo { position: absolute; left: 8%; top: 10%; width: 76%; height: 72.25%; overflow: hidden; outline: 1px solid var(--line-strong) }
  .photo img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: normal; transition: transform .6s var(--ease-out) }
  @media (hover: hover) and (pointer: fine) { .photo:hover img { transform: scale(1.03) } }
  .dims { pointer-events: none }
  .dims { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible }
  .dim path, .dim circle { fill: none; stroke: var(--accent); stroke-width: 1.25 }
  .dim circle { fill: var(--accent) }
  .dim text { font: 500 11px var(--mono); letter-spacing: .06em; fill: var(--ink-2); text-anchor: middle }
  .dim text.left { text-anchor: start }
  .drawing figcaption .title-block { border-top-color: var(--line-strong) }
  @media (prefers-reduced-motion: no-preference) {
    .dim path { stroke-dasharray: 600; stroke-dashoffset: 600; animation: draw 1.1s var(--ease-out) forwards }
    .dim text, .dim circle { opacity: 0; animation: appear .5s ease-out forwards }
    .d1 path { animation-delay: .35s } .d1 text { animation-delay: .9s }
    .d2 path { animation-delay: .55s } .d2 text { animation-delay: 1.1s }
    .d3 path { animation-delay: .75s } .d3 text, .d3 circle { animation-delay: 1.3s }
    @keyframes draw { to { stroke-dashoffset: 0 } }
    @keyframes appear { to { opacity: 1 } }
  }

  .stages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px }
  .stage { display: flex; flex-direction: column; background: var(--sheet); border: 1px solid var(--line); transition: border-color .2s ease }
  .stage-img { display: grid; place-items: center; aspect-ratio: 4 / 3; border-bottom: 1px solid var(--line); overflow: hidden }
  .stage-img img { max-width: 72%; max-height: 78%; object-fit: contain; mix-blend-mode: multiply; transition: transform .45s var(--ease-out) }
  .stage-body { display: grid; gap: 8px; padding: 18px 20px 12px; align-content: start; flex: 1 }
  .stage-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px }
  .stage-head a { text-decoration: none }
  .stage-body > p { font-size: 14.5px }
  .count { white-space: nowrap; font-size: 11px }
  .machine-links { list-style: none; margin: 8px 0 0; padding: 0; border-top: 1px solid var(--line) }
  .machine-links a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 8px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 15px; font-weight: 500 }
  .machine-links li:last-child a { border-bottom: 0 }
  .machine-links .icon { color: var(--accent); flex: none; transition: transform .25s var(--ease-out) }
  @media (hover: hover) and (pointer: fine) {
    .stage:hover { border-color: var(--line-strong) }
    .stage:hover .stage-img img { transform: scale(1.04) }
    .machine-links a:hover { color: var(--accent) }
    .machine-links a:hover .icon { transform: translateX(3px) }
    .stage-head a:hover { color: var(--accent) }
  }
  @media (max-width: 1000px) { .stages { grid-template-columns: repeat(2, minmax(0, 1fr)) } }
  @media (max-width: 640px) {
    .stages { grid-template-columns: minmax(0, 1fr) }
    .stage { display: grid; grid-template-columns: 38% minmax(0, 1fr) }
    .stage-img { aspect-ratio: auto; border-bottom: 0; border-right: 1px solid var(--line); align-self: stretch }
    .stage-img img { max-width: 86% }
    .stage-body { padding: 14px 14px 6px }
    .stage-body > p { display: none }
    .machine-links a { font-size: 14px; min-height: 40px }
  }

  .about { background: var(--sheet) }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start }
  .process { list-style: none; margin: 0; padding: 0; counter-reset: p; border-top: 1px solid var(--ink) }
  .process li { counter-increment: p; display: grid; grid-template-columns: 48px 1fr; gap: 4px 12px; padding: 22px 0; border-bottom: 1px solid var(--line) }
  .process li::before { content: counter(p, decimal-leading-zero); grid-row: span 2; font: 500 13px/1.8 var(--mono); color: var(--accent) }
  .process p { font-size: 15.5px }

  .industries { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--ink) }
  .industries li { padding: 20px 20px 24px 0; border-right: 1px solid var(--line); display: grid; gap: 6px; align-content: start }
  .industries li + li { padding-left: 20px }
  .industries li:last-child { border-right: 0 }
  .industries p { font-size: 14.5px }

  .visit-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center }
  .visit .ctas { margin-top: 28px }
  .visit-side { display: grid; gap: 16px; min-width: 0 }
  .map-card { position: relative; display: block; height: 170px; border: 1px solid var(--line-strong); background: var(--sheet); overflow: hidden }
  .map-card iframe { width: 100%; height: 100%; border: 0; display: block; pointer-events: none; filter: grayscale(.2) contrast(1.05) }
  .map-cta { position: absolute; left: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 6px; background: var(--ink); color: #fff; font: 600 12.5px var(--body); padding: 8px 12px }
  .map-cta .icon { color: var(--accent-line) }
  @media (hover: hover) { .map-card:hover { border-color: var(--ink) } .map-card:hover .map-cta { background: var(--accent) } .map-card:hover .map-cta .icon { color: #fff } }
  .office .span { grid-column: 1 / -1; border-bottom: 1px solid var(--line) }
  .office > div:nth-child(n+2) { border-top: 0 }
  .office > div:nth-child(4) { border-left: 0; border-top: 1px solid var(--line) }
  .office > div:nth-child(5) { border-top: 1px solid var(--line) }
  .office dd { display: grid; gap: 2px }
  .office a { text-decoration: none }

  @media (max-width: 1000px) {
    .hero-grid, .about-grid, .visit-grid { grid-template-columns: minmax(0, 1fr) }
    .industries { grid-template-columns: repeat(2, minmax(0, 1fr)) }
    .industries li, .industries li + li { padding: 18px 16px 20px 0; border-right: 0; border-bottom: 1px solid var(--line) }
  }
  @media (max-width: 760px) {
    .dim text { font-size: 14px }
    .ctas .btn { flex: 1 1 auto }
  }
  @media (max-width: 480px) { .industries { grid-template-columns: minmax(0, 1fr) } }
</style>
