---
import Icon from './Icon.astro'
import { waLink, company, tel } from '../data/products'
interface Props { message?: string }
const { message = "Hi RK Enterprises, I'd like to enquire about your process equipment." } = Astro.props
---
<nav class="action-bar" aria-label="Quick contact">
  <a class="ab ab-call" href={tel(company.phones[0])}><Icon name="phone" size={20} /><span>Call</span></a>
  <a class="ab ab-wa" href={waLink(message)} target="_blank" rel="noopener"><Icon name="chat" size={20} /><span>WhatsApp</span></a>
  <a class="ab ab-quote" href="/contact/"><Icon name="arrow" size={20} /><span>Get a quote</span></a>
</nav>

<style>
  .action-bar { display: none }
  @media (max-width: 860px) {
    .action-bar { position: fixed; z-index: 30; left: 12px; right: 12px; bottom: calc(10px + env(safe-area-inset-bottom, 0px)); display: grid; grid-template-columns: 1fr 1.25fr 1.25fr; gap: 6px; padding: 6px; background: rgba(19, 33, 42, .78); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); border: 1px solid rgba(255, 255, 255, .14); border-radius: 18px; box-shadow: 0 18px 36px -14px rgba(10, 20, 26, .6) }
    .ab { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 13px; color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; transition: transform .14s var(--ease-out), background-color .2s ease }
    .ab:active { transform: scale(.95) }
    .ab-call { background: rgba(255, 255, 255, .12) }
    .ab-wa { background: var(--wa) }
    .ab-quote { background: var(--accent) }
  }
  @media (prefers-reduced-transparency: reduce) { .action-bar { background: var(--ink); backdrop-filter: none; -webkit-backdrop-filter: none } }
</style>
